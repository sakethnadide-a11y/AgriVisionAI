# Environment & Credentials (NEVER commit these)
.env
.env.*
!.env.example
*.env
backend/.env
credentials.json
client_secrets.json

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Database files
*.db
*.sqlite
*.sqlite3
instance/

