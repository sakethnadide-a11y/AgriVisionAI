# ============================================================
# AGRIVISIONAI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file with real secrets!
# ============================================================

# Flask Secret Key (generate a random string for production)
SECRET_KEY=your-secret-key-here

# Database Configuration (PostgreSQL or fallback to SQLite)
# Example PostgreSQL: postgresql+psycopg2://username:password@localhost:5432/agrivisionai
# Example SQLite: sqlite:///agrivisionai.db
DATABASE_URL=sqlite:///agrivisionai.db

# OpenWeatherMap API Key (Get from: https://openweathermap.org/api)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# CEDA API Key (Center for Economic Data and Analysis)
CEDA_API_KEY=
CEDA_BASE_URL=https://api.ceda.ashoka.edu.in/v1

# Email Configuration (Flask-Mail for OTP and contact messages)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
